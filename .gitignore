# ---- IDE ----
# JetBrains（PyCharm / IntelliJ）工程配置，属本地环境产物，不同机器会互相冲突
.idea/
*.iml
.vscode/

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Python ----
# 项目当前尚无代码，以下为后续开发预留；如不用 Python 可整段删除
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# ---- 密钥与环境变量 ----
.env

# ---- 项目数据与运行产物 ----
# 原始数据和中间产物通常体积较大或受许可限制，不直接提交
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
experiments/*/artifacts/
experiments/*/logs/
outputs/
